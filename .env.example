# Word Intelligence v0.4 - Environment Configuration Template

# General
ENVIRONMENT=development
PROJECT_NAME="Word Intelligence"
API_V1_STR=/api/v1

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (MySQL - for Phase 6)
# MYSQL_SERVER=localhost
# MYSQL_PORT=3306
# MYSQL_USER=wordintel
# MYSQL_PASSWORD=secret
# MYSQL_DB=word_intelligence
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_SERVER}:${MYSQL_PORT}/${MYSQL_DB}

# Storage & Upload Limits (bytes)
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
MAX_TEXT_LENGTH_CHARS=500000
HTTP_REQUEST_TIMEOUT_SECONDS=10
